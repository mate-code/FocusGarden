<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondFragment">

    <ProgressBar
        android:id="@+id/pbFocusTimer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:rotation="180"
        android:progressDrawable="@drawable/custom_circular_progress_bar"
        app:layout_constraintBottom_toTopOf="@+id/btnCategory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivSelectedFlower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="flowerImage"
        android:src="@drawable/ic_launcher_foreground"
        tools:layout_editor_absoluteY="200dp"
        app:layout_constraintBottom_toBottomOf="@+id/pbFocusTimer"
        app:layout_constraintEnd_toEndOf="@+id/pbFocusTimer"
        app:layout_constraintStart_toStartOf="@+id/pbFocusTimer"
        app:layout_constraintTop_toTopOf="@+id/pbFocusTimer" />

    <Button
        android:id="@+id/btnCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:enabled="false"
        app:layout_constraintBottom_toTopOf="@+id/tvFocusTime"
        app:layout_constraintEnd_toEndOf="@+id/pbFocusTimer"
        app:layout_constraintStart_toStartOf="@+id/pbFocusTimer"
        app:layout_constraintTop_toBottomOf="@+id/pbFocusTimer" />

    <TextView
        android:id="@+id/tvFocusTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autofillHints="00:25"
        android:ems="10"
        android:text="00:25"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:height="98dp"
        android:textColorHint="#8D6E63"
        app:layout_constraintBottom_toTopOf="@+id/btnStopFocusTimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCategory"
        app:autoSizeTextType="uniform"/>



    <Button
        android:id="@+id/btnStopFocusTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFocusTime" />

</androidx.constraintlayout.widget.ConstraintLayout>
